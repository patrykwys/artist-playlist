# Copy to .env and fill in. Never commit .env.

# Spotify app from https://developer.spotify.com/dashboard (Web API).
# Add this exact Redirect URI in the app settings: http://127.0.0.1:4200/api/auth/callback
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Free key from https://www.last.fm/api/account/create
LASTFM_API_KEY=

# Encrypts your Spotify tokens inside the database. Generate once, from the api folder:
#   node -p "require('node:crypto').randomBytes(32).toString('base64')"
# Keep it: changing it logs you out (nothing else is lost).
TOKEN_ENCRYPTION_KEY=

# Optional overrides (defaults shown)
# DATABASE_PATH=data/artist-mix.db
# PORT=3000
# APP_URL=http://127.0.0.1:4200
# SPOTIFY_REDIRECT_URI=http://127.0.0.1:4200/api/auth/callback
# USER_AGENT=artist-playlist/0.1 (personal project)
